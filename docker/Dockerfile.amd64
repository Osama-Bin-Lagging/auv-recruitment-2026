# ROS 2 Humble + Ignition Fortress, headless.
#
# amd64 only: ros-humble-ros-gz-sim is not published for arm64 jammy (only the
# bridge/image/interfaces shims are), so Apple Silicon must run this emulated.
# The grader never opens the GUI, so software-only physics is all we need.
FROM --platform=linux/amd64 ros:humble-ros-base

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      wget gnupg ca-certificates \
    && wget -qO /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
         https://packages.osrfoundation.org/gazebo.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
http://packages.osrfoundation.org/gazebo/ubuntu-stable jammy main" \
         > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      ignition-fortress \
      ros-humble-ros-gz-sim \
      ros-humble-ros-gz-bridge \
      ros-humble-ros-gz-image \
      ros-humble-ros-gz-interfaces \
      ros-humble-xacro \
      python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Headless: no GUI, software rendering only.
ENV IGN_GAZEBO_RESOURCE_PATH=/work/models \
    IGN_GAZEBO_SYSTEM_PLUGIN_PATH=/opt/ros/humble/lib \
    LIBGL_ALWAYS_SOFTWARE=1 \
    QT_QPA_PLATFORM=offscreen

WORKDIR /work
